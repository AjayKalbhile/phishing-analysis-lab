# ============================================================
# .env.example — API Key Configuration Template
# 
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Add your keys:   nano .env
#   3. NEVER commit .env to git (it's in .gitignore)
# ============================================================

# VirusTotal API Key (Required for VT lookups)
# Get free key at: https://www.virustotal.com/gui/join-us
VT_API_KEY=your_virustotal_api_key_here

# AlienVault OTX API Key (Optional — threat intel enrichment)
# Get free key at: https://otx.alienvault.com/api
OTX_API_KEY=your_otx_api_key_here

# AbuseIPDB API Key (Optional — IP reputation)
# Get free key at: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=your_abuseipdb_key_here
